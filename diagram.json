{
  "version": 1,
  "author": "Rafael Feitosa",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led_edge",
      "top": -80,
      "left": 160,
      "attrs": { "color": "green", "label": "EDGE" }
    },
    {
      "type": "wokwi-led",
      "id": "led_cloud",
      "top": -80,
      "left": 220,
      "attrs": { "color": "yellow", "label": "CLOUD" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_complexity",
      "top": 160,
      "left": 80,
      "attrs": { "label": "COMPLEXITY" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -40,
      "left": 160,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r2",
      "top": -40,
      "left": 220,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:D2", "r1:1", "green", [] ],
    [ "r1:2", "led_edge:A", "green", [] ],
    [ "led_edge:C", "esp:GND.1", "black", [] ],
    [ "esp:D4", "r2:1", "yellow", [] ],
    [ "r2:2", "led_cloud:A", "yellow", [] ],
    [ "led_cloud:C", "esp:GND.2", "black", [] ],
    [ "pot_complexity:VCC", "esp:3V3", "red", [] ],
    [ "pot_complexity:GND", "esp:GND.3", "black", [] ],
    [ "pot_complexity:SIG", "esp:D34", "purple", [] ]
  ]
}
